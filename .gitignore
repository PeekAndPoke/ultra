*.iml
/.idea/modules.xml
/.idea/modules/
/.idea/workspace.xml
/.idea/tasks.xml
/.idea/misc.xml
/.idea/ClojureProjectResolveSettings.xml
/.idea/artifacts
/.idea/libraries
/.idea/shelf
dataSources.ids
datasources.xml

.kotlin

!buildSrc
.gradle
**/build/
.kotlintest
/tmp
**/tmp

# credential
publishing.gradle.properties

# Claude Code harness runtime files
.claude/*.lock
