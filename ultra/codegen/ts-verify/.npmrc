# Pin the Node.js used to run the verify script. pnpm downloads and manages it, so the result does
# not depend on whatever node happens to be on PATH.
use-node-version=22.12.0

# Let pnpm enforce the `packageManager` field itself, switching to that exact pnpm version.
# Deliberately NOT corepack: corepack 0.29.x (bundled with Node 22) ships a rotated npm registry
# signing key and fails signature verification, and the usual workaround is COREPACK_INTEGRITY_KEYS=0
# — disabling supply-chain verification, which is the opposite of why this repo standardised on pnpm.
manage-package-manager-versions=true
