---
import DocsLayout from '../../../layouts/DocsLayout.astro';
import Aside from '../../../components/Aside.astro';
import {funktorSidebar} from '../../../data/funktor-sidebar';
import {Code} from 'astro:components';
---

<DocsLayout title="Cluster Module" sidebar={funktorSidebar}
            description="Background jobs, file storage, locks, and workers">

    <h1>Cluster</h1>

    <p class="text-xl text-gray-400 !mt-2 !mb-8">
        Background jobs, file depot, distributed locks, scheduled workers, and key-value storage.
    </p>

    <p>The cluster module provides server-side infrastructure that goes beyond request handling.
        Everything is accessible through <code>cluster</code> &mdash; a facade available in any handler.</p>

    <h2>Background jobs</h2>

    <p>Queue work for asynchronous execution with typed input/output and retry policies.</p>

    <Code code={`class SendWelcomeEmail(
    backgroundJobs: Lazy<BackgroundJobs>,
) : BackgroundJobs.Handler<SendWelcomeEmail.Input, SendWelcomeEmail.Output>(
    backgroundJobs, kType()
) {
    data class Input(val userId: String, val email: String)
    data class Output(val sent: Boolean)

    override val jobType = "send-welcome-email"

    override suspend fun execute(job: BackgroundJobQueued, data: Input): Output {
        mailService.send(data.email, "Welcome!")
        return Output(sent = true)
    }
}

// Queue a job from any handler:
welcomeEmailHandler.queue(
    data = SendWelcomeEmail.Input(userId = "123", email = "user@example.com"),
    retryPolicy = BackgroundJobRetryPolicy.LinearDelay(delayInMs = 5000, maxTries = 3),
)`} lang="kotlin" theme="vitesse-dark"/>

    <h2>File depot</h2>

    <p>Abstract file storage with pluggable backends. Same API for local filesystem and AWS S3.</p>

    <p>
        Every write names the data subject the file is about. A repository is typed by the kind of subject it
        holds, and a stored entity is its own subject id (<code>collection/key</code>). Files that belong to no
        person are written for <code>DepotSubjectId.system</code>. Metadata is stored in clear: keep personal data
        out of it.
    </p>

    <Code code={`// A repository of customer files, registered in the kontainer and injected with its type
class CustomerFiles(dir: String) : FileSystemRepository<Customer>("customer-files", dir)

// Upload for a stored customer, with free metadata
customerFiles.putFile(customer, "photos/avatar.jpg", imageBytes, mapOf("mime-type" to "image/jpeg"))

// A file of the system itself; a repository looked up by name takes only these
val repo = cluster.depot.getRepo("uploads")
repo?.putFile(DepotSubjectId.system, "reports/latest.json", report)

// List, and read the metadata
val files = customerFiles.listItems("photos/")
val meta = customerFiles.getMeta("photos/avatar.jpg")   // mime-type, depot-subject=customers/42, depot-sha256=...

// Compare the file with the hash stored at its write: Intact, Damaged or NoHash
val state = customerFiles.verify("photos/avatar.jpg")

// Download: DepotContent.Found(bytes), NotFound, or Shredded (an erased subject's file)
val content = cluster.depot.getContent(DepotUri("customer-files", "photos/avatar.jpg"))
val bytes = content.bytesOrNull()`} lang="kotlin" theme="vitesse-dark"/>

    <h3>Encrypted files, erasable per person</h3>

    <p>
        An encrypting repository stores every file encrypted, with a key of its own that the key of its data subject
        wraps. Erasing a subject's key makes all of that subject's files unreadable, in every copy and backup of the
        files. The keys live in the cluster's database (<code>useKarango()</code> or <code>useMonko()</code>), as
        they are: a database backup from before the erasure still holds the key until it expires, so keep those
        backups only as long as an erasure may take. Metadata stays plain.
    </p>

    <Code code={`// The inner repository is built here and registered nowhere else
class CustomerFiles(dir: String, keys: DepotKeyStore) : EncryptingDepotRepository<Customer>(
    inner = object : FileSystemRepository<Customer>("customer-files", dir) {},
    keys = keys,
)

// kontainer: DepotKeyStore comes from funktorCluster { useKarango() }
dynamic(CustomerFiles::class) { keys: DepotKeyStore -> CustomerFiles("/data/customer-files", keys) }

customerFiles.putFile(customer, "contract.pdf", pdfBytes)

when (val content = customerFiles.getContent("contract.pdf")) {
    is DepotContent.Found -> content.bytes
    DepotContent.Shredded -> null   // the customer was erased
    DepotContent.NotFound -> null
}

// Right to erasure: every file of this customer becomes unreadable, and later writes for it are refused
// for good: an erased subject id must never be given to someone else.
// Throws when the key could not be erased.
customerFiles.shred(customer.asDepotSubject())`} lang="kotlin" theme="vitesse-dark"/>

    <p>
        For files that need not be secret but must not be changed unnoticed, a
        <code>SignedDepotRepository</code> is built the same way. It stores files as they are, with a keyed hash,
        and its <code>verify(path)</code> finds tampering with the content, the path, the subject or the metadata.
        Only <code>Intact</code> proves a file; treat every other answer as not proven
        (<code>Unverifiable</code>: the subject's key was erased). Signed files are not
        erased by <code>shred</code>.
    </p>

    <h2>Distributed locks</h2>

    <p>Coordinate work across server instances with database-backed global locks.</p>

    <Code code={`// Acquire lock, run work, release automatically
cluster.locks.global.lock("invoice-generation", timeout = 10.seconds) {
    generateMonthlyInvoices()
}

// Try to acquire (returns null on timeout)
val result = cluster.locks.global.tryToLock("resource", timeout = 5.seconds) {
    doWork()
}`} lang="kotlin" theme="vitesse-dark"/>

    <h2>Workers</h2>

    <p>Scheduled background tasks that run at defined intervals.</p>

    <Code code={`class CleanupWorker : Worker {
    override val id = "cleanup-old-sessions"
    override val shouldRun = Worker.Every.hours(1)

    override suspend fun execute(state: StateProvider) {
        sessionRepo.deleteOlderThan(Duration.ofDays(30))
    }
}`} lang="kotlin" theme="vitesse-dark"/>

    <h2>Key-value storage</h2>

    <p>Typed persistent storage and volatile caching with TTL policies.</p>

    <Code code={`// Persistent storage
val category = RandomDataStorage.category<UserPrefs>("prefs")
cluster.storage.randomData.save(category, "user-123", prefs)
val loaded = cluster.storage.randomData.load(category, "user-123")

// Cache with TTL
val cacheCategory = RandomCacheStorage.category<PricingData>(
    "pricing",
    RawCacheDataModel.Policy.ServeCacheAndRefresh(ttl = 3600, refreshAfter = 1800)
)
val pricing = cluster.storage.randomCache.getOrPut(cacheCategory.bind("EUR")) {
    fetchPricingFromApi()
}`} lang="kotlin" theme="vitesse-dark"/>

    <Aside>All cluster features use the same pluggable storage backends as auth &mdash;
        Karango or Monko. Jobs, locks, files, and cache entries are all persisted to your database of choice.
    </Aside>

    <div class="mt-12">
        <a href="/ultra/funktor/messaging"
           class="inline-flex items-center gap-2 px-6 py-3 rounded-lg bg-brand-400/10 text-brand-400 border border-brand-400/30 hover:bg-brand-400/20 transition-all font-medium">
            Messaging Module &rarr;
        </a>
    </div>

</DocsLayout>
