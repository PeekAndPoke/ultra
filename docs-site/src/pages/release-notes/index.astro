---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import {releaseNotes} from '../../data/releaseNotes';
import {githubRepo} from '../../data/site';
---

<BaseLayout title="Release notes"
            description="What each release of the PeekAndPoke libraries brings, and what to change when updating.">
    <Nav/>

    <main class="pt-28 pb-16 px-4 sm:px-6">
        <div class="max-w-3xl mx-auto">

            <h1 class="text-4xl font-bold text-white mb-2">Release notes</h1>
            <p class="text-gray-400 mb-10">
                What each release brings, and what to change when updating. Every single change is in the
                <a href={`${githubRepo}/blob/master/CHANGELOG.md`}
                   class="text-brand-400 hover:text-brand-300 transition-colors">changelog</a>.
            </p>

            {releaseNotes.map((note) => (
                <a href={`/release-notes/${note.version}/`}
                   class="block p-6 mb-4 rounded-xl border border-white/10 bg-white/[0.02] hover:border-brand-400/40 transition-colors">
                    <div class="flex items-baseline gap-3 mb-1">
                        <h2 class="text-xl font-semibold text-brand-400">{note.version}</h2>
                        <span class="text-sm text-gray-500">{note.date}</span>
                    </div>
                    <p class="text-gray-400">{note.summary}</p>
                </a>
            ))}
        </div>
    </main>
</BaseLayout>
